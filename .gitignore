# ---- ESP-IDF build outputs (regenerate with idf.py build) ----
build/
sdkconfig
sdkconfig.old

# Fetched components: reproducible from idf_component.yml + dependencies.lock,
# which ARE tracked. dependencies.lock pins BSP 2.0.0 (the SH8601 revision) and
# is the thing that keeps the wrong panel driver from creeping back in.
managed_components/

# archived ESP-IDF stages: build output only, sources stay tracked
archive/*/build/
archive/*/sdkconfig
archive/*/sdkconfig.old
archive/*/managed_components/

# ---- upstream clone, reproducible ----
# git clone --depth 1 \
#   https://github.com/waveshareteam/ESP32-S3-Touch-AMOLED-1.8.git waveshare-demo
waveshare-demo/

# ---- editor / OS ----
*.swp
*~
.DS_Store

# scratch clones for reference
tmp/

# build logs: kept in-repo (never /tmp, which the OS evicts) but not tracked
logs/
tests/host/host_render
tests/host/digest_test
tests/host/gfx_test
tests/host/gfx_png
tests/host/*.ppm
tests/host/*.png
tests/host/ui_test
tests/host/vg_test
tests/host/game_test
tests/host/game_png

# ---- device flash dumps: NOT redistributable, NOT small ----
# A full 16MB stock dump is 16MB of Espressif managed components and Waveshare's
# factory app in compiled form. It was tracked once; the history was rewritten to
# drop it. Keep your own copy here to restore the board - it stays out of git.
#   esptool --chip esp32s3 -b 921600 read_flash 0 0x1000000 backup/stock-full-16MB.bin
#
# The DUMP is ignored. backup/RESTORE.md and the .sha256 stay tracked - the
# instructions and the integrity check are the parts worth sharing, and they
# are what make the ignored file reproducible.
backup/*.bin
